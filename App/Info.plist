			<string>com.kingpinapps.cardano-txworkshop.text-envelope</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tx</string>
					<string>signed</string>
					<string>txsigned</string>
					<string>witnessed</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
