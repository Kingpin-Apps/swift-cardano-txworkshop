			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbor</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Cardano Transaction Hex</string>
			<key>UTTypeIdentifier</key>
			<string>com.kingpinapps.cardano-txworkshop.transaction-hex</string>
