# Cloudflare Pages headers for txworkshop.app. GitHub Pages ignores this file.
# Cloudflare Web Analytics loads its beacon from static.cloudflareinsights.com
# and reports to cloudflareinsights.com; the privacy policy describes it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
